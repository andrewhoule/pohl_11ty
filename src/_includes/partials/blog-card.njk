{% set cardCategory = post | topCategory %}
<article class="blog-excerpt-wrap">
  <div class="blog-excerpt">
    <div class="blog-excerpt-img">
      <a href="{{ post.url }}">
        <img src="{{ post.featuredImage or '/assets/images/default.jpg' }}" alt="{{ post.title }}">
      </a>
    </div>
    <div class="blog-excerpt-details">
      <h3 class="title"><a href="{{ post.url }}">{{ post.title }}</a></h3>
      <div class="meta">By <span class="author">{{ post.author }}</span> on <span class="category">{% if cardCategory %}<a href="{{ cardCategory.url }}">{{ cardCategory.name }}</a>{% endif %}</span></div>
      <div class="excerpt">{{ post.excerpt }}</div>
    </div>
  </div>
</article>

---
pagination:
  data: scriptures
  size: 1
  alias: scripture
permalink: "{{ scripture.url | normalizeUrl }}index.html"
layout: layouts/base.njk
bodyClass: page page-scripture-detail
eleventyComputed:
  pageTitle: "{{ scripture.name }}"
  metaDescription: "{{ scripture.scripture | stripHtml | excerpt(160) }}"
---
<section class="page-content-wrap">
  <header class="page-header">
    <h1 class="page-title ct">Scripture</h1>
    <hr>
  </header>
  <main class="page-content">
    <div class="scripture-main">
      <figure class="featured-scripture">
        <blockquote>{{ scripture.scripture | safe }}</blockquote>
        <figcaption>{{ scripture.book }}&nbsp;{{ scripture.verse }}</figcaption>
      </figure>
    </div>
    <aside class="scripture-more">
      <section class="sidebar-block">
        <h3>Categories</h3>
        <ul class="button-list">
          {% for category in scriptureCategories %}
          {% if category.scriptures.length %}
          <li><a href="{{ category.url }}" class="ghost-button-sm">{{ category.name }}</a></li>
          {% endif %}
          {% endfor %}
        </ul>
      </section>
    </aside>
  </main>
</section>

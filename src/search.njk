---
layout: layouts/base.njk
permalink: /search/index.html
pageTitle: Search
metaDescription: "Search posts, books, and scripture."
bodyClass: page page-search
---
<section class="page-content-wrap">
  <header class="page-header">
    <h1 class="page-title ct">Search</h1>
    <hr>
  </header>
  <main class="page-content search-page">
    <form class="search-page-form" action="/search/" method="get" data-search-page-form>
      <label class="search-page-label" for="site-search">Search posts, books, and scripture</label>
      <div class="search-page-controls">
        <input id="site-search" class="search-page-input" type="search" name="q" autocomplete="off" data-search-input>
        <button type="submit" class="ghost-button">Search</button>
      </div>
    </form>
    <div class="search-status" data-search-status></div>
    <section class="blog-excerpts" data-search-results></section>
  </main>
</section>
